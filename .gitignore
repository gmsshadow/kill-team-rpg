# Never commit the rulebook or any other Games Workshop material
docs/rulebook/
*.pdf

node_modules/
.DS_Store
Thumbs.db

# Compiled compendium packs are build artifacts. packs/_source holds the
# version-controlled JSON; run tools/build-packs.mjs to regenerate.
# Note this must exclude the directory wholesale: LevelDB keeps recent writes
# in .log files, so ignoring *.log alone would commit a pack missing entries.
packs/*/
!packs/_source/
