{
  "id": "kill-team-rpg",
  "title": "Kill Team 2018 (Lightweight RPG)",
  "description": "A lightweight roleplaying system built on the Warhammer 40,000: Kill Team (2018) core rules. Operative datacards, weapon profiles, specialisms, experience tracks and the D6 attack sequence.",
  "version": "0.23.0",
  "compatibility": {
    "minimum": "13",
    "verified": "14"
  },
  "authors": [
    {
      "name": "GMsShadow",
      "url": "https://github.com/GMsShadow"
    }
  ],
  "esmodules": [
    "module/kill-team.mjs"
  ],
  "styles": [
    "styles/kill-team.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "packs": [
    {
      "name": "factions",
      "label": "Kill Team Factions",
      "path": "packs/factions",
      "type": "Item",
      "system": "kill-team-rpg",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "weapons",
      "label": "Kill Team Weapons & Wargear",
      "path": "packs/weapons",
      "type": "Item",
      "system": "kill-team-rpg",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "specialisms",
      "label": "Kill Team Specialisms",
      "path": "packs/specialisms",
      "type": "Item",
      "system": "kill-team-rpg",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "models",
      "label": "Kill Team Model Datasheets",
      "path": "packs/models",
      "type": "Item",
      "system": "kill-team-rpg",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    }
  ],
  "documentTypes": {
    "Actor": {
      "operative": {
        "htmlFields": [
          "abilities",
          "notes"
        ]
      },
      "killteam": {
        "htmlFields": [
          "notes",
          "background"
        ]
      }
    },
    "Item": {
      "weapon": {
        "htmlFields": [
          "description"
        ]
      },
      "ability": {
        "htmlFields": [
          "description"
        ]
      },
      "wargear": {
        "htmlFields": [
          "description"
        ]
      },
      "specialism": {
        "htmlFields": [
          "description"
        ]
      },
      "faction": {
        "htmlFields": [
          "description"
        ]
      },
      "model": {
        "htmlFields": [
          "description"
        ]
      }
    }
  },
  "grid": {
    "distance": 1,
    "units": "in",
    "size": 100
  },
  "primaryTokenAttribute": "wounds",
  "url": "https://github.com/gmsshadow/kill-team-rpg",
  "manifest": "https://raw.githubusercontent.com/gmsshadow/kill-team-rpg/refs/heads/main/system.json",
  "download": "https://github.com/gmsshadow/kill-team-rpg/archive/refs/heads/main.zip",
  "license": "LICENSE.md",
  "readme": "README.md",
  "bugs": "https://github.com/gmsshadow/kill-team-rpg/issues",
  "packFolders": [
    {
      "name": "Kill Team",
      "sorting": "m",
      "color": "#c8501e",
      "packs": [
        "factions",
        "specialisms",
        "models",
        "weapons"
      ]
    }
  ]
}
